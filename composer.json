{
    "name": "you/inventory-system",
    "description": "Multi-tenant inventory system",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-bcmath": "*",
        "ext-mbstring": "*",
        "monolog/monolog": "^3.5",
        "ramsey/uuid": "^4.7",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.40",
        "robmorgan/phinx": "^0.16"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "db:test:migrate": "vendor/bin/phinx migrate -e development",
        "test:isolation": ["@db:test:migrate", "phpunit --testsuite Isolation"],
        "ci": ["@cs:check", "@stan", "@test"]
    },
    "config": {
        "sort-packages": true
    }
}
